# Optional for the league module. The EGGS shell runs without credentials.
# Keep all three on the server. Never prefix the service key with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Existing newsroom providers are configured separately when needed.
# Consumer rollout stays disabled until the reviewed migration and retention
# worker are installed and hosted Auth callback/session checks pass.
EGGS_CONSUMER_ENABLED=false
# Exact origin: HTTPS in deployment, HTTP allowed only on loopback for development.
EGGS_SITE_URL=http://localhost:3000

# Netlify scheduled function environment only. Never expose this key to clients.
EGGS_CLAIM_RETENTION_ENABLED=false
EGGS_RETENTION_SERVICE_KEY=
